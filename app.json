{
  "expo": {
    "name": "Broke?",
    "slug": "expense-tracker",
    "scheme": "expensetracker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mayank.moneytracker"
    },
    "android": {
      "package": "com.mayank.moneytracker",
      "adaptiveIcon": {
        "backgroundColor": "#141413",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39861d24-e2b4-4a81-8055-e7435e64fadd"
      }
    },
    "owner": "mayankkalra03"
  }
}
